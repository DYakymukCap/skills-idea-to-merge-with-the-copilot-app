---
// Bookmarks component (scaffold).
//
// Dynamic behavior runs only in the inline client-side script below.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    normalizeUrl,
    nextSlug,
    parseStoredBookmarks,
  } from '../lib/bookmarks.mjs';

  const STORAGE_KEY = 'mona-bookmarks';
  const COUNTER_KEY = 'mona-bookmarks-counter';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  let bookmarks = [];

  function readCounter() {
    try {
      const value = Number.parseInt(localStorage.getItem(COUNTER_KEY) ?? '0', 10);
      return Number.isSafeInteger(value) && value >= 0 ? value : 0;
    } catch {
      return 0;
    }
  }

  function persist() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Rendering remains available even if browser storage is unavailable.
    }
  }

  function setSavedState() {
    const hasBookmarks = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = hasBookmarks;
    if (listHeader) listHeader.hidden = !hasBookmarks;
  }

  function render() {
    if (!list) return;
    list.replaceChildren();

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const urlLink = document.createElement('a');
      urlLink.className = 'url';
      urlLink.href = bookmark.url;
      urlLink.textContent = bookmark.url;
      urlLink.target = '_blank';
      urlLink.rel = 'noopener noreferrer';

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copyButton.textContent = 'Copied';
          window.setTimeout(() => {
            copyButton.textContent = 'Copy';
          }, 1200);
        } catch {
          copyButton.textContent = 'Copy failed';
        }
      });

      item.append(urlLink, separator, slug, copyButton);
      list.append(item);
    }

    setSavedState();
  }

  function loadBookmarks() {
    try {
      bookmarks = parseStoredBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      bookmarks = [];
    }
    render();
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!(input instanceof HTMLInputElement)) return;
    const url = normalizeUrl(input.value);
    if (!url) {
      input.setCustomValidity('Enter a valid URL.');
      input.reportValidity();
      return;
    }
    input.setCustomValidity('');

    const generated = nextSlug(bookmarks, readCounter());
    bookmarks = [...bookmarks, { url, slug: generated.slug }];

    try {
      localStorage.setItem(COUNTER_KEY, String(generated.counter));
    } catch {
      // The in-memory counter and list still work for this session.
    }

    persist();
    render();
    input.value = '';
    input.focus();
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Clear every saved bookmark?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
      localStorage.removeItem(COUNTER_KEY);
    } catch {
      // State is already cleared in memory.
    }
    render();
  });

  loadBookmarks();
</script>
